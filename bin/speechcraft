#!/bin/sh
set -eu
entry=$0
while [ -L "$entry" ]; do
  link_dir=$(CDPATH= cd "$(dirname "$entry")" && pwd -P)
  link=$(readlink "$entry")
  case $link in /*) entry=$link ;; *) entry=$link_dir/$link ;; esac
done
bin_dir=$(CDPATH= cd "$(dirname "$entry")" && pwd -P)
app_root=$(CDPATH= cd "$bin_dir/.." && pwd -P)
node="$app_root/runtime/node"
if [ -x "$node" ]; then
  exec "$node" "$app_root/launcher/src/cli.js" "$@"
fi
if [ -f "$app_root/application-release-manifest.json" ]; then
  printf '%s\n' 'speechcraft: the bundled Node runtime is missing or not executable; reinstall the verified application package.' >&2
  exit 1
fi
# Explicit source-checkout mode for contributors. Installed releases never use PATH Node.
if [ -f "$app_root/launcher/src/launcher.js" ] && [ -d "$app_root/setup-controller" ]; then
  node=$(command -v node || true)
  if [ -z "$node" ]; then printf '%s\n' 'speechcraft: source development requires Node.js 20.9 or newer.' >&2; exit 1; fi
  exec "$node" "$app_root/launcher/src/cli.js" "$@"
fi
printf '%s\n' 'speechcraft: could not resolve the SpeechCraft application resources.' >&2
exit 1

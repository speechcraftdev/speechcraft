# Set these to local installs/checkpoints; never commit private paths or secrets.
SPEECHCRAFT_EXPERIMENT_DIR=/path/to/private/run-directory
SPEECHCRAFT_EXPERIMENT_PLAN=/path/to/private/run-directory/experiment-plan.json
SPEECHCRAFT_ASR_PYTHON=/path/to/asr-environment/bin/python
SPEECHCRAFT_SPEAKER_PYTHON=/path/to/speaker-environment/bin/python
VOXCPM_REPO=/path/to/VoxCPM
VOXCPM_BASE_MODEL=/path/to/VoxCPM1.5
VOXCPM_PYTHON=/path/to/voxcpm-environment/bin/python
F5TTS_REPO=/path/to/F5-TTS
F5TTS_BASE_CHECKPOINT=/path/to/F5TTS_v1_Base.safetensors
F5TTS_PYTHON=/path/to/f5-environment/bin/python

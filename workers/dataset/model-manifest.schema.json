{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://speechcraft.local/schemas/model-manifest-v1.json",
  "title": "SpeechCraft model manifest",
  "type": "object",
  "required": ["schema_version", "models"],
  "properties": {
    "schema_version": { "const": 1 },
    "models": {
      "type": "array", "minItems": 4, "maxItems": 4,
      "items": { "$ref": "#/$defs/model" }
    }
  },
  "$defs": {
    "file": {
      "type": "object", "required": ["path"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "size_bytes": { "type": "integer", "minimum": 0 },
        "min_size_bytes": { "type": "integer", "minimum": 0 },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      },
      "additionalProperties": false
    },
    "artifact": {
      "type": "object",
      "required": ["platform", "format", "revision", "availability", "required_files"],
      "properties": {
        "platform": { "type": "string", "minLength": 1 },
        "format": { "type": "string", "minLength": 1 },
        "revision": { "type": "string", "minLength": 1 },
        "availability": { "enum": ["verified", "unresolved"] },
        "required_files": { "type": "array", "items": { "$ref": "#/$defs/file" } },
        "release_blockers": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": false
    },
    "model": {
      "type": "object",
      "required": ["id", "role", "name", "license", "access", "artifacts", "runtime_validation"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "role": { "enum": ["diarization", "asr", "speech_detection", "speaker_purity"] },
        "name": { "type": "string", "minLength": 1 },
        "license": { "type": "object", "required": ["identifier", "source"], "properties": { "identifier": { "type": "string" }, "source": { "type": "string" }, "status": { "enum": ["verified", "unresolved"] } }, "additionalProperties": true },
        "access": { "type": "object", "required": ["requirements"], "properties": { "requirements": { "type": "array", "items": { "type": "string" } }, "source": { "type": "string" } }, "additionalProperties": true },
        "artifacts": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/artifact" } },
        "runtime_validation": { "type": "object", "required": ["contract", "status"], "properties": { "contract": { "type": "array", "items": { "type": "string" } }, "status": { "enum": ["deferred", "verified"] } }, "additionalProperties": true }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}

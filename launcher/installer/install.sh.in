#!/bin/sh
set -eu
RELEASE_TAG='@@RELEASE_TAG@@'
APP_VERSION='@@APP_VERSION@@'
SOURCE_REVISION='@@SOURCE_REVISION@@'
ASSET_BASE_URL='@@ASSET_BASE_URL@@'
LINUX_ARCHIVE='@@LINUX_ARCHIVE@@'
LINUX_ARCHIVE_SHA256='@@LINUX_ARCHIVE_SHA256@@'
LINUX_ARCHIVE_SIZE='@@LINUX_ARCHIVE_SIZE@@'
LINUX_CHECKSUM_SHA256='@@LINUX_CHECKSUM_SHA256@@'
LINUX_CHECKSUM_SIZE='@@LINUX_CHECKSUM_SIZE@@'
LINUX_MANIFEST_SHA256='@@LINUX_MANIFEST_SHA256@@'
LINUX_MANIFEST_SIZE='@@LINUX_MANIFEST_SIZE@@'
INSTALL_LINUX_PY_SHA256='@@INSTALL_LINUX_PY_SHA256@@'
INSTALL_LINUX_PY_SIZE='@@INSTALL_LINUX_PY_SIZE@@'
INSTALL_LINUX_SH_SHA256='@@INSTALL_LINUX_SH_SHA256@@'
INSTALL_LINUX_SH_SIZE='@@INSTALL_LINUX_SH_SIZE@@'
MACOS_ARCHIVE='@@MACOS_ARCHIVE@@'
MACOS_ARCHIVE_SHA256='@@MACOS_ARCHIVE_SHA256@@'
MACOS_ARCHIVE_SIZE='@@MACOS_ARCHIVE_SIZE@@'
MACOS_CHECKSUM_SHA256='@@MACOS_CHECKSUM_SHA256@@'
MACOS_CHECKSUM_SIZE='@@MACOS_CHECKSUM_SIZE@@'
MACOS_MANIFEST_SHA256='@@MACOS_MANIFEST_SHA256@@'
MACOS_MANIFEST_SIZE='@@MACOS_MANIFEST_SIZE@@'
INSTALL_MACOS_SH_SHA256='@@INSTALL_MACOS_SH_SHA256@@'
INSTALL_MACOS_SH_SIZE='@@INSTALL_MACOS_SH_SIZE@@'

step=startup
stderr_is_tty=0
install_verbose=0
fail() { printf 'SpeechCraft installer: failed at %s: %s\n' "$step" "$*" >&2; printf 'SpeechCraft installer: correct the problem and run the installer again.\n' >&2; exit 1; }
say() { printf '%s\n' "$*" >&2; }
size_of() { wc -c < "$1" | tr -d '[:space:]'; }
sha_of() { shasum -a 256 "$1" | awk '{print $1}'; }
verify() { [ "$(size_of "$1")" = "$3" ] && [ "$(sha_of "$1")" = "$2" ]; }
download() {
  name=$1 target=$2
  step="fetching $name"
  if [ "$name" = "$archive" ]; then
    say "Fetching $name ($archive_size bytes expected)"
  else say "Fetching $name"; fi
  set -- --fail --show-error --location --max-redirs 3 --proto "$curl_proto" --proto-redir '=https' --retry 3 --retry-delay 1 --connect-timeout 15 --max-time 600
  if [ "$name" = "$archive" ] && { [ "$stderr_is_tty" -eq 1 ] || [ "$install_verbose" -eq 1 ]; }; then set -- "$@" --progress-bar; else set -- "$@" --silent; fi
  set -- "$@" --output "$target" --write-out '%{url_effective}' "$base_url/$name"
  effective=$(curl "$@") || fail "download failed for $name."
  case "$base_url" in
    https://github.com/speechcraftdev/speechcraft/releases/download/*) case "$effective" in https://github.com/*|https://release-assets.githubusercontent.com/*|https://objects.githubusercontent.com/*|https://github-releases.githubusercontent.com/*) ;; *) fail "download for $name ended at an unexpected host." ;; esac ;;
    *) [ "$effective" = "$base_url/$name" ] || fail "staged download for $name left its pinned URL." ;;
  esac
  say "Fetched $name ($(size_of "$target") bytes)"
}
verify_file() {
  step="SHA-256 check for $(basename "$1")"
  if ! verify "$1" "$2" "$3"; then
    name=$(basename "$1")
    case "$name" in *.tar.gz) fail 'archive verification failed; nothing was installed.' ;; *.sha256) fail 'release checksum verification failed.' ;; *.release.json) fail 'release manifest verification failed.' ;; install-*) fail 'official installer verification failed.' ;; *) fail "SHA-256 or size verification failed for $name." ;; esac
  fi
  say "Verified SHA-256 for $(basename "$1")"
}

[ "$#" -eq 0 ] || fail 'this release-pinned installer takes no arguments.'
step='platform check'
say "Checking platform and prerequisites for SpeechCraft $APP_VERSION"
os=$(uname -s 2>/dev/null || true); arch=$(uname -m 2>/dev/null || true)
case "$os/$arch" in
  Linux/x86_64|Linux/amd64) platform=linux; say 'Platform checks passed: Linux x86-64' ;;
  Darwin/arm64|Darwin/aarch64) platform=macos; say 'Platform checks passed: Apple Silicon macOS' ;;
  Darwin/x86_64) fail 'supported platform: Linux x86-64 and Apple Silicon macOS only. Intel Mac is unsupported.' ;;
  MINGW*/*|MSYS*/*|CYGWIN*/*) fail 'Native Windows is not supported by this installer. See the Windows installation instructions.' ;;
  *) fail "unsupported platform $os/$arch. Supported: Linux x86-64 and Apple Silicon macOS." ;;
esac
command -v curl >/dev/null 2>&1 || fail 'curl is required.'
command -v mktemp >/dev/null 2>&1 || fail 'mktemp is required.'
command -v rm >/dev/null 2>&1 || fail 'rm is required.'
if [ "$platform" = linux ]; then
  command -v python3 >/dev/null 2>&1 || fail 'system Python 3.9 or newer is required for Linux installation.'
  python3 -c 'import sys; raise SystemExit(0 if sys.version_info >= (3,9) else 1)' || fail 'system Python 3.9 or newer is required; install it using your OS package manager and retry.'
else
  command -v shasum >/dev/null 2>&1 || fail 'macOS shasum is required.'
  command -v plutil >/dev/null 2>&1 || fail 'macOS plutil is required.'
fi
if [ -t 2 ]; then stderr_is_tty=1; fi
case ${SPEECHCRAFT_INSTALL_VERBOSE:-} in 1|true|TRUE|yes|YES|verbose|VERBOSE) install_verbose=1 ;; esac
if command -v sha256sum >/dev/null 2>&1; then sha_of() { sha256sum "$1" | awk '{print $1}'; }; fi
case "$ASSET_BASE_URL" in https://*) curl_proto='=https' ;; http://127.0.0.1:*|http://localhost:*) curl_proto='=http' ;; *) fail 'release asset base URL must use HTTPS (HTTP is allowed only for loopback staging).' ;; esac
if [ "$platform" = linux ]; then
  archive=$LINUX_ARCHIVE archive_sha=$LINUX_ARCHIVE_SHA256 archive_size=$LINUX_ARCHIVE_SIZE
  checksum_sha=$LINUX_CHECKSUM_SHA256 checksum_size=$LINUX_CHECKSUM_SIZE manifest_sha=$LINUX_MANIFEST_SHA256 manifest_size=$LINUX_MANIFEST_SIZE
  installer_one=install-linux.py installer_one_sha=$INSTALL_LINUX_PY_SHA256 installer_one_size=$INSTALL_LINUX_PY_SIZE
  installer_two=install-linux.sh installer_two_sha=$INSTALL_LINUX_SH_SHA256 installer_two_size=$INSTALL_LINUX_SH_SIZE
else
  [ -n "$MACOS_ARCHIVE" ] || fail 'this legacy Linux release does not include a macOS ARM64 package.'
  archive=$MACOS_ARCHIVE archive_sha=$MACOS_ARCHIVE_SHA256 archive_size=$MACOS_ARCHIVE_SIZE
  checksum_sha=$MACOS_CHECKSUM_SHA256 checksum_size=$MACOS_CHECKSUM_SIZE manifest_sha=$MACOS_MANIFEST_SHA256 manifest_size=$MACOS_MANIFEST_SIZE
  installer_one=install-macos.sh installer_one_sha=$INSTALL_MACOS_SH_SHA256 installer_one_size=$INSTALL_MACOS_SH_SIZE
fi
step='temporary directory'
tmp_root=${TMPDIR:-/tmp}; tmp_dir=$(mktemp -d "$tmp_root/speechcraft-install.XXXXXXXX") || fail 'could not create a private temporary directory.'
trap 'rm -rf "$tmp_dir"' EXIT HUP INT TERM
base_url=$ASSET_BASE_URL
archive_path="$tmp_dir/$archive"
download "$archive" "$archive_path"
download "$archive.sha256" "$archive_path.sha256"
download "$archive.release.json" "$archive_path.release.json"
download "$installer_one" "$tmp_dir/$installer_one"
if [ "$platform" = linux ]; then download "$installer_two" "$tmp_dir/$installer_two"; fi
step='download verification'
verify_file "$archive_path" "$archive_sha" "$archive_size"
verify_file "$archive_path.sha256" "$checksum_sha" "$checksum_size"
verify_file "$archive_path.release.json" "$manifest_sha" "$manifest_size"
verify_file "$tmp_dir/$installer_one" "$installer_one_sha" "$installer_one_size"
if [ "$platform" = linux ]; then verify_file "$tmp_dir/$installer_two" "$installer_two_sha" "$installer_two_size"; fi
step='release identity check'
if [ "$platform" = linux ]; then
  python3 - "$archive_path.sha256" "$archive_path.release.json" "$archive" "$archive_sha" "$archive_size" "$APP_VERSION" "$SOURCE_REVISION" <<'PY' || fail 'release metadata mismatch.'
import json,pathlib,re,sys
c,m,a,h,s,v,r=sys.argv[1:]
if pathlib.Path(c).read_text().strip().split()!=[h,a]: raise SystemExit(1)
x=json.loads(pathlib.Path(m).read_text())
e={'schema_version':1,'archive':a,'archive_sha256':h,'archive_size_bytes':int(s),'application_version':v,'platform':'linux-x86_64','source_revision':r}
if any(x.get(k)!=val for k,val in e.items()): raise SystemExit(1)
if not re.fullmatch(r'[a-f0-9]{64}',str(x.get('model_manager_wheel_sha256',''))): raise SystemExit(1)
PY
else
  checksum_value=; checksum_name=; checksum_extra=
  IFS=' ' read -r checksum_value checksum_name checksum_extra < "$archive_path.sha256" || fail 'Mac checksum file is malformed.'
  [ "$checksum_value" = "$archive_sha" ] && [ "$checksum_name" = "$archive" ] && [ -z "$checksum_extra" ] || fail 'Mac checksum content mismatch.'
  [ "$(plutil -extract platform raw -o - "$archive_path.release.json")" = macos-arm64 ] || fail 'Mac release platform mismatch.'
  [ "$(plutil -extract source_revision raw -o - "$archive_path.release.json")" = "$SOURCE_REVISION" ] || fail 'Mac release revision mismatch.'
  [ "$(plutil -extract application_version raw -o - "$archive_path.release.json")" = "$APP_VERSION" ] || fail 'Mac release version mismatch.'
  [ "$(plutil -extract archive raw -o - "$archive_path.release.json")" = "$archive" ] || fail 'Mac archive identity mismatch.'
  [ "$(plutil -extract archive_sha256 raw -o - "$archive_path.release.json")" = "$archive_sha" ] || fail 'Mac release digest mismatch.'
  [ "$(plutil -extract archive_size_bytes raw -o - "$archive_path.release.json")" = "$archive_size" ] || fail 'Mac release size mismatch.'
fi
say "Verified release manifest for SpeechCraft $APP_VERSION"
step='package installation'
say "Installing verified SpeechCraft $APP_VERSION package"
if [ "$platform" = linux ]; then
  (cd "$tmp_dir" && sh "$tmp_dir/install-linux.sh" "$archive_path") || fail 'verified Linux package was not activated.'
else
  sh "$tmp_dir/install-macos.sh" "$archive_path" "$archive_sha" "$archive_size" "$SOURCE_REVISION" || fail 'verified Mac package was not activated.'
fi
say ''
say "SpeechCraft $APP_VERSION is installed."
say 'Open a new terminal to use `speechcraft`, or source the PATH configuration shown by the installer.'
say 'Model and runtime preparation happens in the local setup page.'
